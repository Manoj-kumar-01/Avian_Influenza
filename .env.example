# ==========================================================
# AvianGuard AI — Environment Configuration Template
# Duplicate this file to .env and fill in your actual credentials.
# ==========================================================

# ── Telegram Bot Configuration ──
# Get your token in 1 minute from Telegram @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── Database Configuration (MongoDB Atlas) ──
# Get your connection string from MongoDB Atlas -> Connect -> Drivers -> Python
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/?retryWrites=true&w=majority&appName=AvianGuard
MONGODB_DB_NAME=avian_guard

# ── Alert Notification Toggles (Disabled by default for privacy & security) ──
ENABLE_EMAIL_ALERTS=false
ENABLE_EXTERNAL_PUSH=false

# Optional: Email Alerts (SMTP) - Only active if ENABLE_EMAIL_ALERTS=true
SMTP_EMAIL=your_email@example.com
SMTP_PASSWORD=your_app_password
RECEIVER_EMAILS=alerts@example.com

# Optional: Push Notification Topic (ntfy.sh) - Only active if ENABLE_EXTERNAL_PUSH=true
NTFY_TOPIC=your_private_topic_here

