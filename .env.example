# ==========================================================
# AvianGuard AI — Environment Configuration Template
# Duplicate this file to .env and fill in your actual credentials.
# ==========================================================

# ── Telegram Bot Configuration ──
# Get your token in 1 minute from Telegram @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── Database Configuration ──
# Default: Local SQLite (sqlite:///avian_guard.db)
# Production: PostgreSQL URL (e.g. postgresql://user:pass@host:5432/dbname)
DATABASE_URL=sqlite:///avian_guard.db

# ── Email Alerts (SMTP) ──
# Note: For Gmail, create a 16-character App Password at https://myaccount.google.com/apppasswords
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password
RECEIVER_EMAILS=veterinarian@farm.com,alerts@poultrycorp.com

# ── Push Notification Mirror (ntfy.sh) ──
NTFY_TOPIC=birdflu7
